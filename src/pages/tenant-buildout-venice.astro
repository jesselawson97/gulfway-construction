---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="Tenant Buildouts"
  serviceSlug="tenant-buildout"
  city="Venice"
  county="Sarasota County"
  headline="Tenant Buildout Contractor in Venice, FL"
  subheadline="From raw shell to move-in ready — on schedule, on budget, built to your exact specs. Serving Venice and Sarasota County."
  intro="Venice is one of Florida's fastest-growing markets for new commercial tenants. Gulfway Construction provides professional tenant buildout services in Venice, FL — giving businesses a move-in ready space without the headaches of managing construction yourself."
  body={[
    "We work with Venice-area landlords, commercial real estate brokers, and tenants to coordinate the full buildout scope. From permit applications through final CO, Gulfway handles every phase with a single point of contact.",
    "Our transparent pricing model means no surprise change orders. We define the full scope upfront, price it accurately, and deliver what we promised — on time."
  ]}
  bullets={[
    "Permit drawings & permitting handled in-house",
    "Framing, drywall, ceilings & flooring",
    "Electrical, plumbing & HVAC coordination",
    "Storefront, glass & entry systems",
    "ADA compliance review",
    "Punch list walkthrough & 1-year warranty"
  ]}
  heroImage="/images/service-buildout.jpg"
  heroAlt="Commercial tenant buildout in Venice FL"
/>
