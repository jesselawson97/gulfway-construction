---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = "ADA Compliance Contractor | Gulfway Construction — Bradenton & Sarasota FL";
const description = "Gulfway Construction provides commercial ADA compliance remediation across Manatee & Sarasota County, FL. Parking, ramps, restrooms, and entrances brought to code. Call 941-730-8491.";
const canonical = "https://gulfwayconstruction.com/ada-compliance";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "ADA Compliance Remediation",
  "provider": {
    "@type": "GeneralContractor",
    "name": "Gulfway Construction",
    "url": "https://gulfwayconstruction.com",
    "telephone": "+19417308491",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bradenton",
      "addressRegion": "FL",
      "addressCountry": "US"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Bradenton" },
    { "@type": "City", "name": "Sarasota" },
    { "@type": "City", "name": "Palmetto" },
    { "@type": "City", "name": "Venice" }
  ],
  "description": description
};

const cities = [
  { name: "Bradenton", slug: "ada-compliance-bradenton" },
  { name: "Sarasota", slug: "ada-compliance-sarasota" },
  { name: "Palmetto", slug: "ada-compliance-palmetto" },
  { name: "Venice", slug: "ada-compliance-venice" }
];
---
<Base title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Nav />

  <section class="lp-hero">
    <div class="lp-hero-bg">
      <img src="/images/service-interior.jpg" alt="ADA compliance remediation in Florida" loading="eager" />
    </div>
    <div class="lp-hero-overlay"></div>
    <div class="lp-hero-content container">
      <p class="hero-eyebrow">Commercial Contractor — Bradenton, FL</p>
      <h1>ADA Compliance Remediation</h1>
      <p class="hero-sub">Code-correct ADA remediation for commercial properties across Manatee &amp; Sarasota County. Lawsuit, settlement, or proactive — we make your building compliant.</p>
      <a href="#contact" class="btn btn-white">Get a Free Consultation</a>
    </div>
  </section>

  <section class="lp-intro">
    <div class="container">
      <div class="lp-intro-inner">
        <div class="lp-intro-text">
          <span class="section-label">ADA Compliance</span>
          <h2>Bring Your Commercial Property Into ADA Compliance</h2>
          <p class="lp-lead">Florida is one of the highest-volume states for ADA accessibility lawsuits. If your business has been served with a demand letter or you want to get ahead of the risk, Gulfway Construction remediates accessibility violations to code — and documents the work so you can prove it.</p>
          <p>We remediate to the 2010 ADA Standards for Accessible Design, correcting the issues that most commonly trigger claims: non-compliant parking and access aisles, improperly sloped ramps and missing curb cuts, narrow or heavy doors, inaccessible entrances, and restrooms that fail clearance and fixture requirements.</p>
          <p>As a licensed commercial contractor based in Bradenton, we handle every trade involved — concrete, interior alterations, doors, hardware, and signage — under one contractor. You get before-and-after documentation suitable for attorneys, courts, or the DOJ.</p>
          <a href="#contact" class="btn btn-gold" style="margin-top:1.5rem">Start Your Project</a>
        </div>
        <div class="lp-bullets-box">
          <h3>What We Remediate</h3>
          <ul>
            <li>Accessible parking, striping &amp; signage</li>
            <li>ADA-compliant ramps &amp; curb cuts</li>
            <li>Entrance, door width &amp; hardware upgrades</li>
            <li>Restroom remediation &amp; clearances</li>
            <li>Path-of-travel modifications</li>
            <li>Before-and-after documentation</li>
          </ul>
          <div class="lp-cta-box">
            <p>Served with a demand letter?</p>
            <a href="tel:9417308491">941-730-8491</a>
            <a href="#contact" class="btn btn-gold" style="margin-top:.75rem;width:100%;text-align:center">Request a Quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-why">
    <div class="container">
      <span class="section-label">Why Gulfway</span>
      <h2>The Commercial Contractor for ADA Remediation</h2>
      <div class="lp-why-grid">
        <div class="lp-why-card">
          <h3>Done to Code</h3>
          <p>We remediate to the 2010 ADA Standards — because incorrect repairs leave you exposed to continued liability.</p>
        </div>
        <div class="lp-why-card">
          <h3>Fast Turnaround</h3>
          <p>Lawsuits and settlement deadlines move quickly. We prioritize remediation work and keep your project on schedule.</p>
        </div>
        <div class="lp-why-card">
          <h3>One Contractor</h3>
          <p>Concrete, interior, doors, hardware, and signage — all coordinated under one licensed commercial contractor.</p>
        </div>
        <div class="lp-why-card">
          <h3>Documented</h3>
          <p>Before-and-after documentation you can present to attorneys, courts, or the DOJ to demonstrate compliance.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-process" style="background:var(--light)">
    <div class="container">
      <span class="section-label">Service Areas</span>
      <h2>ADA Compliance Across Manatee &amp; Sarasota County</h2>
      <div class="lp-related-grid" style="margin-top:2rem">
        {cities.map(c => (
          <a href={`/${c.slug}`} class="lp-related-card">
            <span>ADA Compliance in {c.name}</span>
            <i>&rarr;</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-info">
          <span class="section-label">Let's Talk</span>
          <h2>Get an ADA Remediation Quote</h2>
          <p>Tell us about your property and we'll reach out within one business day. If you've been served, mention your deadline — we'll prioritize accordingly.</p>
          <div class="contact-detail"><strong>Phone:</strong> <span>941-730-8491</span></div>
          <div class="contact-detail"><strong>Email:</strong> <span>projects@gulfwayconstruction.com</span></div>
        </div>
        <form class="contact-form" method="POST" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value="8e57c099-bf52-4809-b261-521a3afe7b05" />
          <input type="hidden" name="subject" value="ADA Compliance Inquiry — Gulfway Construction" />
          <input type="hidden" name="redirect" value="https://gulfwayconstruction.com" />
          <input type="hidden" name="project-type" value="ADA Compliance Remediation" />
          <div class="form-row">
            <input type="text" name="first-name" placeholder="First Name" required />
            <input type="text" name="last-name" placeholder="Last Name" required />
          </div>
          <input type="email" name="email" placeholder="Email Address" required />
          <input type="tel" name="phone" placeholder="Phone Number" />
          <textarea name="message" placeholder="Tell us about your property and any deadline…"></textarea>
          <button type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
.lp-hero { position: relative; min-height: 60vh; display: flex; align-items: center; }
.lp-hero-bg { position: absolute; inset: 0; }
.lp-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
.lp-hero-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(26,26,26,.80) 0%, rgba(26,26,26,.55) 100%); }
.lp-hero-content { position: relative; z-index: 1; color: var(--white); padding-top: 120px; padding-bottom: 4rem; }
.lp-hero-content h1 { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.15; margin: .5rem 0 1rem; }
.lp-hero-content .hero-eyebrow { font-size: .75rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-lt); }
.lp-hero-content .hero-sub { font-size: 1.1rem; max-width: 580px; margin-bottom: 2rem; opacity: .9; }
.lp-intro { padding: 5rem 0; }
.lp-intro-inner { display: grid; grid-template-columns: 1fr 380px; gap: 4rem; align-items: start; }
.lp-intro-text h2 { font-family: var(--font-serif); font-size: clamp(1.6rem, 3vw, 2.2rem); margin: .5rem 0 1.25rem; }
.lp-lead { font-size: 1.1rem; color: var(--mid); margin-bottom: 1rem; }
.lp-intro-text p { color: var(--mid); margin-bottom: .9rem; }
.lp-bullets-box { background: var(--light); border-left: 4px solid var(--gold); padding: 2rem; border-radius: var(--radius); position: sticky; top: 130px; }
.lp-bullets-box h3 { font-size: 1rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1rem; }
.lp-bullets-box ul { list-style: none; margin-bottom: 1.5rem; }
.lp-bullets-box ul li { padding: .4rem 0 .4rem 1.4rem; position: relative; font-size: .95rem; color: var(--mid); border-bottom: 1px solid rgba(0,0,0,.07); }
.lp-bullets-box ul li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
.lp-cta-box { text-align: center; padding-top: 1.25rem; }
.lp-cta-box p { font-size: .85rem; color: var(--mid); margin-bottom: .25rem; }
.lp-cta-box > a:first-of-type { display: block; font-size: 1.4rem; font-weight: 700; color: var(--gold); margin-bottom: .25rem; }
.lp-why { background: var(--dark); color: var(--white); padding: 5rem 0; }
.lp-why .section-label { color: var(--gold-lt); }
.lp-why h2 { font-family: var(--font-serif); font-size: clamp(1.6rem, 3vw, 2.2rem); margin: .5rem 0 2.5rem; }
.lp-why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; }
.lp-why-card { border-top: 2px solid var(--gold); padding-top: 1.25rem; }
.lp-why-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: .6rem; }
.lp-why-card p { font-size: .9rem; color: rgba(255,255,255,.7); line-height: 1.65; }
.lp-process { padding: 4rem 0; }
.lp-process h2 { font-family: var(--font-serif); font-size: clamp(1.4rem, 2.5vw, 2rem); margin: .5rem 0 0; }
.lp-related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
.lp-related-card { background: var(--white); border-radius: var(--radius); border-left: 3px solid var(--gold); padding: 1.1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: .95rem; transition: transform .2s, box-shadow .2s; }
.lp-related-card:hover { transform: translateX(3px); box-shadow: 0 4px 14px rgba(0,0,0,.08); }
.lp-related-card i { color: var(--gold); font-style: normal; font-size: 1.2rem; }
@media (max-width: 860px) {
  .lp-intro-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .lp-bullets-box { position: static; }
}
</style>
