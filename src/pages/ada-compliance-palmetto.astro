---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="ADA Compliance Remediation"
  serviceSlug="ada-compliance"
  city="Palmetto"
  county="Manatee County"
  headline="ADA Compliance Contractor in Palmetto, FL"
  subheadline="Fast, code-correct ADA remediation for commercial properties in Palmetto and Manatee County. Lawsuit, settlement, or proactive — we bring your building into compliance."
  intro="Gulfway Construction provides commercial ADA compliance remediation in Palmetto, FL. Whether you've received a demand letter, settled a claim with a remediation deadline, or want to get compliant before a problem arises, we fix accessibility violations correctly and document the work."
  body={[
    "We remediate to the 2010 ADA Standards for Accessible Design — accessible parking, compliant ramps and curb cuts, door and entrance modifications, and full restroom upgrades. Incorrect repairs leave you liable, so we do it right the first time.",
    "As a licensed commercial contractor, Gulfway handles every trade involved — concrete, interior alterations, doors, hardware, and signage — under one roof, with before-and-after documentation to prove compliance."
  ]}
  bullets={[
    "Accessible parking, striping & signage",
    "ADA-compliant ramps & curb cuts",
    "Entrance, door width & hardware upgrades",
    "Restroom remediation (grab bars, clearances, fixtures)",
    "Path-of-travel & interior modifications",
    "Before-and-after compliance documentation"
  ]}
  heroImage="/images/service-interior.jpg"
  heroAlt="ADA compliance remediation in Palmetto FL"
/>
