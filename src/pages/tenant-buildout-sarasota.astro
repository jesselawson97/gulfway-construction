---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="Tenant Buildouts"
  serviceSlug="tenant-buildout"
  city="Sarasota"
  county="Sarasota County"
  headline="Tenant Buildout Contractor in Sarasota, FL"
  subheadline="From raw shell to move-in ready — on schedule, on budget, built to your exact specs. Serving Sarasota and Sarasota County."
  intro="Signing a lease in Sarasota is just the beginning. The buildout is where your business vision becomes a physical space — and that's where Gulfway Construction delivers. We handle commercial tenant buildouts in Sarasota from permit to punch list."
  body={[
    "Our team coordinates directly with Sarasota County building departments, local inspectors, and your landlord's team to keep the project on track. We've built out retail, office, medical, and food service spaces throughout Sarasota County.",
    "We provide a fixed scope and transparent pricing before work begins. No surprises, no open-ended allowances — just a clear plan and a team that executes it."
  ]}
  bullets={[
    "Permit drawings & permitting handled in-house",
    "Framing, drywall, ceilings & flooring",
    "Electrical, plumbing & HVAC coordination",
    "Storefront, glass & entry systems",
    "ADA compliance review",
    "Punch list walkthrough & 1-year warranty"
  ]}
  heroImage="/images/service-buildout.jpg"
  heroAlt="Commercial tenant buildout in Sarasota FL"
/>
