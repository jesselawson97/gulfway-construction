---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="Commercial Renovations"
  serviceSlug="commercial-renovation"
  city="Bradenton"
  county="Manatee County"
  headline="Commercial Renovation Contractor in Bradenton, FL"
  subheadline="Modernize your commercial space without shutting down your business. Expert renovations serving Bradenton and Manatee County."
  intro="Whether you're refreshing an aging office, expanding a retail floor plan, or completely repositioning a commercial property, Gulfway Construction delivers commercial renovations in Bradenton that are built to minimize disruption and maximize your return."
  body={[
    "We specialize in occupied renovations — projects where your business stays open during construction. Our superintendents plan phased scopes, maintain job site cleanliness, and coordinate work around your operating hours so you don't lose revenue while we work.",
    "From cosmetic upgrades to full structural renovations, Gulfway handles the entire project: permitting, demo, construction, finishes, and final inspections. One point of contact from start to finish."
  ]}
  bullets={[
    "Phased construction to keep your business open",
    "Structural, mechanical & cosmetic scope",
    "Permit drawings & code compliance",
    "Flooring, ceilings, lighting & millwork",
    "HVAC, electrical & plumbing upgrades",
    "1-year builder's warranty at closeout"
  ]}
  heroImage="/images/service-renovation.jpg"
  heroAlt="Commercial renovation project in Bradenton FL"
/>
