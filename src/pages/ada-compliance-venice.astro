---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="ADA Compliance Remediation"
  serviceSlug="ada-compliance"
  city="Venice"
  county="Sarasota County"
  headline="ADA Compliance Contractor in Venice, FL"
  subheadline="Fast, code-correct ADA remediation for commercial properties in Venice and Sarasota County. Lawsuit, settlement, or proactive — we bring your building into compliance."
  intro="Gulfway Construction provides commercial ADA remediation in Venice, FL. With Florida among the top states for accessibility lawsuits, getting compliant — quickly and correctly — protects your business from costly continued liability."
  body={[
    "We remediate to the 2010 ADA Standards for Accessible Design, addressing the violations that most often appear in demand letters: non-compliant parking and access aisles, improperly sloped ramps, narrow or heavy doors, and restrooms that fail clearance and fixture requirements.",
    "Gulfway coordinates the entire remediation as a single licensed commercial contractor and provides before-and-after documentation you can present to attorneys, courts, or the DOJ to demonstrate compliance."
  ]}
  bullets={[
    "Accessible parking, striping & signage",
    "ADA-compliant ramps & curb cuts",
    "Entrance, door width & hardware upgrades",
    "Restroom remediation (grab bars, clearances, fixtures)",
    "Path-of-travel & interior modifications",
    "Before-and-after compliance documentation"
  ]}
  heroImage="/images/service-interior.jpg"
  heroAlt="ADA compliance remediation in Venice FL"
/>
