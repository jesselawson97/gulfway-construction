---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="ADA Compliance Remediation"
  serviceSlug="ada-compliance"
  city="Sarasota"
  county="Sarasota County"
  headline="ADA Compliance Contractor in Sarasota, FL"
  subheadline="Fast, code-correct ADA remediation for commercial properties in Sarasota and Sarasota County. Lawsuit, settlement, or proactive — we bring your building into compliance."
  intro="Florida is one of the highest-volume states for ADA accessibility lawsuits. If your Sarasota business has been served — or you want to get ahead of it — Gulfway Construction provides commercial ADA remediation done to code and documented properly."
  body={[
    "We remediate to the 2010 ADA Standards for Accessible Design, correcting the violations that most commonly trigger lawsuits: non-compliant parking and access aisles, ramps with improper slope, narrow doorways, and restrooms that don't meet clearance and fixture requirements.",
    "Gulfway manages the full remediation as a single licensed commercial contractor — concrete, interior alterations, doors, hardware, and signage — and delivers before-and-after documentation you can use to demonstrate compliance to attorneys, courts, or the DOJ."
  ]}
  bullets={[
    "Accessible parking, striping & signage",
    "ADA-compliant ramps & curb cuts",
    "Entrance, door width & hardware upgrades",
    "Restroom remediation (grab bars, clearances, fixtures)",
    "Path-of-travel & interior modifications",
    "Before-and-after compliance documentation"
  ]}
  heroImage="/images/service-interior.jpg"
  heroAlt="ADA compliance remediation in Sarasota FL"
/>
