---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="ADA Compliance Remediation"
  serviceSlug="ada-compliance"
  city="Bradenton"
  county="Manatee County"
  headline="ADA Compliance Contractor in Bradenton, FL"
  subheadline="Fast, code-correct ADA remediation for commercial properties in Bradenton and Manatee County. Lawsuit, settlement, or proactive — we bring your building into compliance."
  intro="If your business received an ADA demand letter or lawsuit, you need remediation done correctly and quickly. Gulfway Construction provides commercial ADA compliance remediation in Bradenton — fixing accessibility violations the right way, with documentation that protects you."
  body={[
    "ADA lawsuits move fast, and incorrect repairs leave you exposed to continued liability. We remediate to the 2010 ADA Standards for Accessible Design — accessible parking and access aisles, compliant ramps and curb cuts, entrance and door modifications, and restroom upgrades including grab bars, clearances, and fixture heights.",
    "As a licensed commercial contractor based in Bradenton, we coordinate the entire remediation — concrete, interior alterations, doors, hardware, and signage — under one contractor. We provide before-and-after documentation so you can demonstrate compliance to courts, attorneys, or the DOJ."
  ]}
  bullets={[
    "Accessible parking, striping & signage",
    "ADA-compliant ramps & curb cuts",
    "Entrance, door width & hardware upgrades",
    "Restroom remediation (grab bars, clearances, fixtures)",
    "Path-of-travel & interior modifications",
    "Before-and-after compliance documentation"
  ]}
  heroImage="/images/service-interior.jpg"
  heroAlt="ADA compliance remediation in Bradenton FL"
/>
