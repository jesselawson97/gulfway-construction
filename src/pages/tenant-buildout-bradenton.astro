---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="Tenant Buildouts"
  serviceSlug="tenant-buildout"
  city="Bradenton"
  county="Manatee County"
  headline="Tenant Buildout Contractor in Bradenton, FL"
  subheadline="From raw shell to move-in ready — on schedule, on budget, built to your exact specs. Serving Bradenton and Manatee County."
  intro="When your business signs a lease on a new space, every day of construction is a day you're not open. Gulfway Construction specializes in commercial tenant buildouts in Bradenton that are delivered fast, done right, and built to last."
  body={[
    "We work directly with landlords, property managers, and tenants to coordinate every phase — from permit drawings through final inspections. Our team has built out retail spaces, medical offices, restaurants, professional suites, and more across Manatee County.",
    "Every Gulfway buildout starts with a detailed scope of work and a transparent proposal. No vague allowances, no surprise change orders. You'll know exactly what you're getting before we ever pull a permit."
  ]}
  bullets={[
    "Permit drawings & permitting handled in-house",
    "Framing, drywall, ceilings & flooring",
    "Electrical, plumbing & HVAC coordination",
    "Storefront, glass & entry systems",
    "ADA compliance review",
    "Punch list walkthrough & 1-year warranty"
  ]}
  heroImage="/images/service-buildout.jpg"
  heroAlt="Commercial tenant buildout in Bradenton FL"
/>
