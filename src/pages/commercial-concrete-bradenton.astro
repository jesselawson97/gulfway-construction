---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="Commercial Concrete"
  serviceSlug="commercial-concrete"
  city="Bradenton"
  county="Manatee County"
  headline="Commercial Concrete Contractor in Bradenton, FL"
  subheadline="Slabs, flatwork, curbs, and more — delivered on schedule for commercial projects in Bradenton and Manatee County."
  intro="Concrete is one of the most critical scopes in any commercial project. Done right, it's invisible. Done wrong, it causes problems for the life of the building. Gulfway Construction provides commercial concrete services in Bradenton, FL with the quality control and scheduling precision that commercial projects demand."
  body={[
    "We handle commercial concrete flatwork, slabs on grade, curb and gutter, sidewalks, and interior concrete work for tenant buildouts and renovations across Manatee County. Our crews work from engineered drawings and coordinate directly with civil, structural, and MEP trades.",
    "As a licensed general contractor, Gulfway manages concrete as part of a larger project scope or as a standalone trade package. Either way, you get the same accountability and quality standard."
  ]}
  bullets={[
    "Concrete slabs on grade & flatwork",
    "Curb, gutter & sidewalk construction",
    "Interior concrete for buildouts & renovations",
    "Saw cutting & core drilling",
    "Vapor barrier & reinforcement installation",
    "Coordination with structural & civil drawings"
  ]}
  heroImage="/images/service-renovation.jpg"
  heroAlt="Commercial concrete work in Bradenton FL"
/>
