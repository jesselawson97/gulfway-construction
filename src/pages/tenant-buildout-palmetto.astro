---
import ServiceCity from '../layouts/ServiceCity.astro';
---
<ServiceCity
  service="Tenant Buildouts"
  serviceSlug="tenant-buildout"
  city="Palmetto"
  county="Manatee County"
  headline="Tenant Buildout Contractor in Palmetto, FL"
  subheadline="From raw shell to move-in ready — on schedule, on budget, built to your exact specs. Serving Palmetto and Manatee County."
  intro="Opening a new business location in Palmetto? Gulfway Construction delivers commercial tenant buildouts that get you open faster — with less stress and no surprises. We manage every trade from permit to punch list."
  body={[
    "Palmetto's growing commercial corridor means more landlords delivering shell spaces and more tenants needing a reliable contractor to build them out. Gulfway has the local relationships and Manatee County permitting experience to keep your project on track.",
    "We provide a detailed scope and fixed-cost proposal before any work begins. You'll know exactly what's included, what it costs, and when it will be done — before we ever break ground."
  ]}
  bullets={[
    "Permit drawings & permitting handled in-house",
    "Framing, drywall, ceilings & flooring",
    "Electrical, plumbing & HVAC coordination",
    "Storefront, glass & entry systems",
    "ADA compliance review",
    "Punch list walkthrough & 1-year warranty"
  ]}
  heroImage="/images/service-buildout.jpg"
  heroAlt="Commercial tenant buildout in Palmetto FL"
/>
