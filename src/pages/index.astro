---
import Base   from '../layouts/Base.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Gulfway Construction | Gulf Coast Commercial Builder"
  description="Gulfway Construction delivers expert commercial construction along the Gulf Coast — property renovations, tenant buildouts, and interior alterations."
>
  <Nav />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <img src="/images/hero.jpg" alt="Gulfway Construction project" loading="eager" />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Gulf Coast Commercial Construction</p>
      <h1>Built with <em>intention.</em><br />Designed for business.</h1>
      <p class="hero-sub">
        From commercial renovations to new tenant buildouts, Gulfway Construction
        delivers quality craftsmanship and reliable execution on every project.
      </p>
      <a href="#contact" class="btn btn-white">Talk to Us About Your Project</a>
    </div>
  </section>

  <!-- Services -->
  <section class="services-strip" id="services">
    <div class="container">
      <span class="section-label">What We Do</span>
      <h2 class="section-title">Commercial Construction Services</h2>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🏢</div>
          <h3>Commercial Renovations</h3>
          <p>Full-scale commercial property renovations that modernize your space, improve functionality, and minimize business disruption.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🔑</div>
          <h3>Tenant Buildouts</h3>
          <p>New tenant buildouts delivered on schedule and on budget — from raw shell to move-in ready, built to your exact specifications.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📐</div>
          <h3>Interior Alterations</h3>
          <p>Reconfigure, refresh, or repurpose your existing commercial space with expert interior alteration work that keeps operations running.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📋</div>
          <h3>Construction Management</h3>
          <p>Experienced project management from permitting through punch list — transparent communication and accountability at every stage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-inner">
        <div class="about-img">
          <img src="/images/about.jpg" alt="Gulfway Construction team on site" />
          <div class="about-img-accent"></div>
        </div>
        <div class="about-text">
          <span class="section-label">About Gulfway</span>
          <h2 class="section-title">Gulf Coast Commercial Experts</h2>
          <p>
            Gulfway Construction is a Gulf Coast-based commercial contractor specializing
            in renovations, tenant buildouts, and interior alterations. We bring a
            hands-on approach and a commitment to quality that shows in every finished space.
          </p>
          <p>
            Every project is led by an experienced superintendent and backed by a network of
            vetted subcontractors who share our standards. We're locally owned and deeply
            invested in the communities and businesses we build for.
          </p>
          <br />
          <a href="#contact" class="btn btn-gold">Start Your Project</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process" id="process">
    <div class="container">
      <span class="section-label">How We Work</span>
      <h2 class="section-title">Our Process</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-num">1</div>
          <h3>Discovery Call</h3>
          <p>We listen first. A free consultation to understand your vision, timeline, and budget before we ever pick up a pencil.</p>
        </div>
        <div class="process-step">
          <div class="step-num">2</div>
          <h3>Design &amp; Planning</h3>
          <p>Our team develops detailed plans, specifications, and a transparent fixed-price or cost-plus proposal.</p>
        </div>
        <div class="process-step">
          <div class="step-num">3</div>
          <h3>Permitting &amp; Preconstruction</h3>
          <p>We handle permits, subcontractor coordination, and material procurement so groundbreaking happens on schedule.</p>
        </div>
        <div class="process-step">
          <div class="step-num">4</div>
          <h3>Construction</h3>
          <p>Daily updates, a dedicated superintendent on site, and milestone walkthroughs keep you informed every step of the way.</p>
        </div>
        <div class="process-step">
          <div class="step-num">5</div>
          <h3>Delivery &amp; Warranty</h3>
          <p>A thorough punch-list walkthrough, full documentation package, and a 1-year builder's warranty on every project.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-banner">
    <div class="container">
      <h2>Ready to Build Something Great?</h2>
      <p>Let's talk about your project. Free consultations — no pressure, no obligation.</p>
      <a href="#contact" class="btn btn-white">Get in Touch</a>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-info">
          <span class="section-label">Let's Talk</span>
          <h2>Start Your Project Today</h2>
          <p>
            Whether you're ready to break ground or just starting to explore your options,
            we'd love to hear from you. Fill out the form and a member of our team will
            reach out within one business day.
          </p>
          <div class="contact-detail">
            <strong>Phone:</strong> <span>941-730-8491</span>
          </div>
          <div class="contact-detail">
            <strong>Email:</strong> <span>projects@gulfwayconstruction.com</span>
          </div>
          <div class="contact-detail">
            <strong>Office:</strong> <span>123 Harbor Blvd, Pensacola, FL 32501</span>
          </div>
          <div class="contact-detail">
            <strong>Hours:</strong> <span>Mon – Fri, 7 AM – 5 PM CT</span>
          </div>
        </div>
        <form class="contact-form" name="contact" method="POST" data-netlify="true">
          <div class="form-row">
            <input type="text"  name="first-name" placeholder="First Name" required />
            <input type="text"  name="last-name"  placeholder="Last Name"  required />
          </div>
          <input type="email" name="email" placeholder="Email Address" required />
          <input type="tel"   name="phone" placeholder="Phone Number" />
          <select name="project-type">
            <option value="" disabled selected>Project Type</option>
            <option>Commercial Renovation</option>
            <option>Tenant Buildout</option>
            <option>Interior Alterations</option>
            <option>Construction Management</option>
            <option>Other</option>
          </select>
          <textarea name="message" placeholder="Tell us about your project…"></textarea>
          <button type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Base>
