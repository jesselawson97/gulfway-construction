---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Gulfway Construction | Gulf Coast Commercial Contractor',
  description = 'Gulfway Construction is a Gulf Coast commercial contractor specializing in commercial renovations, tenant buildouts, and interior alterations. Serving Pensacola, Destin, Panama City Beach, and surrounding areas.',
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "name": "Gulfway Construction",
  "url": "https://gulfwayconstruction.com",
  "logo": "https://gulfwayconstruction.com/images/logo.png",
  "image": "https://gulfwayconstruction.com/images/hero.jpg",
  "description": "Gulf Coast commercial contractor specializing in commercial renovations, tenant buildouts, and interior alterations.",
  "telephone": "+19417308491",
  "email": "projects@gulfwayconstruction.com",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "FL",
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": "Pensacola" },
    { "@type": "City", "name": "Destin" },
    { "@type": "City", "name": "Fort Walton Beach" },
    { "@type": "City", "name": "Panama City Beach" },
    { "@type": "City", "name": "Navarre" },
    { "@type": "City", "name": "Gulf Breeze" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Commercial Construction Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commercial Renovations" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tenant Buildouts" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Interior Alterations" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Construction Management" } }
    ]
  },
  "sameAs": []
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="commercial contractor Gulf Coast, commercial renovation Florida, tenant buildout Pensacola, interior alterations Destin, commercial construction Panama City Beach" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://gulfwayconstruction.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gulfwayconstruction.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://gulfwayconstruction.com/images/hero.jpg" />
    <meta property="og:site_name" content="Gulfway Construction" />
    <meta property="og:locale" content="en_US" />

    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Gulf Coast, Florida" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/global.css" />

    <!-- Local Business Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
